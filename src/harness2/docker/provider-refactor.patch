+def provider_problems(models: set[str]) -> list[str]:
+    """List the OpenAI-compatible provider's models (GET /models, no inference) and report
+    an unreachable endpoint, a rejected key, or a configured model it does not serve."""
+    url = config.PROVIDER_BASE_URL + "/models"
+    headers = (
+        {"Authorization": f"Bearer {config.PROVIDER_API_KEY}"} if config.PROVIDER_API_KEY else {}
+    )
+    try:
+        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=15) as r:
+            served = {m.get("id") for m in json.load(r).get("data", [])}
+    except urllib.error.HTTPError as exc:
+        return [f"Provider {url}: HTTP {exc.code}; check HARNESS2_PROVIDER_API_KEY"]
+    except (OSError, ValueError) as exc:
+        return [f"Provider {url} unreachable ({exc}); check HARNESS2_PROVIDER_BASE_URL"]
+    missing = sorted(models - served)
+    if missing:
+        return [f"Provider {url} does not list {', '.join(missing)}; served: {sorted(served)}"]
+    return []
+
+
