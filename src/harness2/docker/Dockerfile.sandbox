# Harness² sandbox image: what an executor runs in when HARNESS2_SANDBOX=docker.
# Build: docker compose build sandbox.  See ../README.md section 4.
#
# Bun and OpenCode are not baked in: harness2/sandbox.py mounts dependencies/{opencode,tools}
# read-only from the deps volume, at the same paths as in the harness2 container.
# The sandbox has no internet (pip/npm/GitHub are unreachable), so every tool the agent may
# need is installed here. ripgrep on PATH stops OpenCode downloading it (glob/grep tools).

FROM python:3.12-slim-bookworm

ARG UID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git procps ripgrep \
      pandoc poppler-utils \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
      pandas==2.2.3 numpy==2.1.3 \
      openpyxl==3.1.5 XlsxWriter==3.2.0 \
      python-docx==1.1.2 python-pptx==1.0.2 \
      pdfplumber==0.11.4 matplotlib==3.9.2

RUN useradd -m -u "$UID" -s /bin/bash harness
USER harness
WORKDIR /home/harness

# Bun from the mounted tools/; models.dev is unreachable and the provider is configured
# entirely through OPENCODE_CONFIG_CONTENT.
ENV PATH=/opt/harness2/dependencies/tools/node_modules/.bin:$PATH \
    OPENCODE_DISABLE_MODELS_FETCH=1

# No VOLUME: every sandbox container is removed with its writable layer.
