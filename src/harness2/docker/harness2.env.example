# Copy to harness2.env (read by compose.yaml).

# OpenAI-compatible provider (vLLM / llama.cpp / llama-swap / Ollama on the host).
# Every role whose model is "local/<id>" goes to this endpoint: OpenCode executor + improver,
# Codex executor (needs /v1/responses), JobBench / LAB / WorkBuddy judges.
# Inside the container "localhost" is the container itself. llm-proxy (compose.yaml) forwards to
# host.docker.internal:19001 (override with HARNESS2_LLM_UPSTREAM in the shell or docker/.env)
# and is the only endpoint a sandboxed executor can reach.
HARNESS2_PROVIDER_BASE_URL=http://llm-proxy:19001/v1
HARNESS2_PROVIDER_API_KEY=
# HARNESS2_PROVIDER_ID=local          # model prefix, default "local"
# HARNESS2_PROVIDER_CONTEXT=131072    # context window given to OpenCode
# HARNESS2_PROVIDER_OUTPUT=16384      # max output tokens per call
HARNESS2_SOLVER_MODEL=local/sonnet
HARNESS2_IMPROVER_MODEL=local/sonnet
HARNESS2_JUDGE_MODEL=local/sonnet

# docker: each JobBench OpenCode attempt runs in its own throwaway container (Dockerfile.sandbox)
# with no internet; local: on this container, as upstream does. See ../README.md section 4.
HARNESS2_SANDBOX=docker

# API server (harness2-api, ../README.md section 6). Leave the token empty for no authentication.
# HARNESS2_API_TOKEN=
# HARNESS2_API_PORT=8765              # host port, loopback only
