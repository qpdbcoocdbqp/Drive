# API and UI
APP_PORT=8080
APP_API_TOKEN=change-me
APP_GRADIO_USERNAME=admin
APP_GRADIO_PASSWORD=change-me

# local: custom OpenAI-compatible Responses endpoint
# openai: built-in OpenAI provider using OPENAI_API_KEY
APP_LLM_MODE=local
APP_MODEL=sonnet
APP_LLM_BASE_URL=http://host.docker.internal:19001/v1
APP_LLM_API_KEY=
APP_LOCAL_PROVIDER_ID=local-runtime
OPENAI_API_KEY=

# Runtime limits
APP_TURN_TIMEOUT_SECONDS=120
APP_INTERRUPT_GRACE_SECONDS=10
APP_MAX_CONCURRENCY=4
APP_QUEUE_MAX_SIZE=32
