FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    gnupg \
    ca-certificates \
    apt-transport-https \
    nginx \
    && wget -q -O - https://dl-ssl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/googlechrome-linux-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/googlechrome-linux-keyring.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google.list \
    && apt-get update \
    && apt-get install -y google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r chrome && useradd -u 1000 -r -g chrome -G audio,video chrome \
    && mkdir -p /home/chrome/debug \
    && chown -R chrome:chrome /home/chrome \
    && chmod -R 700 /home/chrome/debug

# nginx config: proxy CDP port 9223 → 9224 with Host: localhost rewrite
COPY nginx-cdp.conf /etc/nginx/sites-available/cdp
RUN ln -sf /etc/nginx/sites-available/cdp /etc/nginx/sites-enabled/cdp \
    && rm -f /etc/nginx/sites-enabled/default

WORKDIR /home/chrome

COPY --chown=chrome:chrome --chmod=755 entrypoint.sh /usr/local/bin/entrypoint.sh

EXPOSE 9223/tcp

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
