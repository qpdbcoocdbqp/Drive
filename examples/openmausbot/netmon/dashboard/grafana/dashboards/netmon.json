{
  "uid": "netmon",
  "title": "OpenMausBot netmon",
  "description": "Connections and DNS lookups recorded by netmon (conntrack + dnsmasq). See plan.md Phase 1.6.",
  "tags": [
    "netmon"
  ],
  "editable": false,
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "name",
        "type": "custom",
        "query": "omb,edge",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "label": "netmon"
      },
      {
        "name": "kind",
        "type": "custom",
        "query": "conn,dns",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "label": "kind"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "omb outbound connections",
      "datasource": {
        "type": "loki",
        "uid": "netmon-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "netmon-loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({job=\"netmon\", name=\"omb\", kind=\"conn\"} | regexp `\\[NEW\\]\\s+(?:ipv[46]\\s+\\d+\\s+)?(?P<proto>[a-z0-9]+)\\s+\\d+\\s.*?src=(?P<src>\\S+) dst=(?P<dst>\\S+)(?: sport=\\d+ dport=(?P<dport>\\d+)| type=(?P<icmptype>\\d+))?` | src != \"\" | dst != \"\" | src !~ \"127\\\\..*|::1\" | dst !~ \"127\\\\..*|::1\" | label_format dport=\"{{ or .dport .icmptype }}\" | dst !~ \"127\\\\.0\\\\.0\\\\.1|172\\\\.25\\\\.0\\\\.2|172\\\\.25\\\\.0\\\\.3|172\\\\.26\\\\.0\\\\.3|::1\" or src =~ \"127\\\\.0\\\\.0\\\\.1|172\\\\.25\\\\.0\\\\.2|172\\\\.25\\\\.0\\\\.3|172\\\\.26\\\\.0\\\\.3|::1\" [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "DNS queries",
      "datasource": {
        "type": "loki",
        "uid": "netmon-loki"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "netmon-loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({job=\"netmon\", kind=\"dns\"} |= \"query[\" | regexp `\\d+ \\S+ query\\[(?P<qtype>\\w+)\\] (?P<qname>\\S+) from ` | qname != \"\" [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "edge inbound connections",
      "datasource": {
        "type": "loki",
