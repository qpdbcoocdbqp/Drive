          "refId": "A",
          "expr": "sum(count_over_time({job=\"netmon\", name=\"edge\", kind=\"conn\"} | regexp `\\[NEW\\]\\s+(?:ipv[46]\\s+\\d+\\s+)?(?P<proto>[a-z0-9]+)\\s+\\d+\\s.*?src=(?P<src>\\S+) dst=(?P<dst>\\S+)(?: sport=\\d+ dport=(?P<dport>\\d+)| type=(?P<icmptype>\\d+))?` | src != \"\" | dst != \"\" | src !~ \"127\\\\..*|::1\" | dst !~ \"127\\\\..*|::1\" | label_format dport=\"{{ or .dport .icmptype }}\" | dst =~ \"127\\\\.0\\\\.0\\\\.1|172\\\\.25\\\\.0\\\\.2|172\\\\.25\\\\.0\\\\.3|172\\\\.26\\\\.0\\\\.2|::1\" | src !~ \"127\\\\.0\\\\.0\\\\.1|172\\\\.25\\\\.0\\\\.2|172\\\\.25\\\\.0\\\\.3|172\\\\.26\\\\.0\\\\.2|::1\" [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ],
      "options": {
