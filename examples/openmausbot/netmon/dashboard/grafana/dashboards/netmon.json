    {
      "id": 4,
      "type": "stat",
      "title": "Flagged DNS queries (AUTHOR / TELEMETRY)",
      "datasource": {
        "type": "loki",
        "uid": "netmon-loki"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "netmon-loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({job=\"netmon\", kind=\"dns\"} |= \"query[\" | regexp `\\d+ \\S+ query\\[(?P<qtype>\\w+)\\] (?P<qname>\\S+) from ` | qname != \"\" | qname =~ \"(?i)(.*\\\\.)?(openmausbot\\\\.com|mausbot\\\\.(com|page))|omb-[a-z0-9-]+\\\\.fly\\\\.dev|.*milindsoni201\\\\.workers\\\\.dev|(?i)(.*\\\\.)?(posthog\\\\.com|sentry\\\\.io|statsig(api)?\\\\.(com|net)|segment\\\\.io|datadoghq\\\\.com)\" [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "omb outbound: destination IP / port",
      "datasource": {
        "type": "loki",
        "uid": "netmon-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "netmon-loki"
          },
          "refId": "A",
          "expr": "topk(100, sum by (dst, dport, proto) (count_over_time({job=\"netmon\", name=\"omb\", kind=\"conn\"} | regexp `\\[NEW\\]\\s+(?:ipv[46]\\s+\\d+\\s+)?(?P<proto>[a-z0-9]+)\\s+\\d+\\s.*?src=(?P<src>\\S+) dst=(?P<dst>\\S+)(?: sport=\\d+ dport=(?P<dport>\\d+)| type=(?P<icmptype>\\d+))?` | src != \"\" | dst != \"\" | src !~ \"127\\\\..*|::1\" | dst !~ \"127\\\\..*|::1\" | label_format dport=\"{{ or .dport .icmptype }}\" | dst !~ \"127\\\\.0\\\\.0\\\\.1|172\\\\.25\\\\.0\\\\.2|172\\\\.25\\\\.0\\\\.3|172\\\\.26\\\\.0\\\\.3|::1\" or src =~ \"127\\\\.0\\\\.0\\\\.1|172\\\\.25\\\\.0\\\\.2|172\\\\.25\\\\.0\\\\.3|172\\\\.26\\\\.0\\\\.3|::1\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "dst": 0,
              "dport": 1,
              "proto": 2,
              "Value": 3
            },
            "renameByName": {
              "Value": "count"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "count",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Loopback excluded. Look up the IP in 'DNS answers' (or run netmon_report.py for the joined host view)."
    },
    {
      "id": 6,
      "type": "table",
      "title": "DNS answers: name → IP",
      "datasource": {
        "type": "loki",
        "uid": "netmon-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "netmon-loki"
          },
          "refId": "A",
          "expr": "topk(100, sum by (rname, ip) (count_over_time({job=\"netmon\", kind=\"dns\"} |~ \" (reply|cached|config) \" | regexp `\\d+ \\S+ (?:reply|cached|config) (?P<rname>\\S+) is (?P<ip>[0-9a-fA-F.:]+)\\s*$` | ip != \"\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "rname": 0,
              "ip": 1,
              "Value": 2
            },
            "renameByName": {
              "Value": "count"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "count",
                "desc": true
