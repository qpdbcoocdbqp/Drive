# Copy to secrets.env (excluded from git) and fill in. After editing, run docker compose up -d so omb is recreated and reads the new values.
# Key for the local LLM (LOCAL_LLM_URL); keep the placeholder if llama-swap does not check keys
OPENAI_COMPAT_API_KEY=not-needed
# API_SERVER_KEY from the Hermes data directory file Drive\.hermes\.env (not the one in examples/hermes/.env)
HERMES_API_KEY=
